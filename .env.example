# Copy to `.env` at the repository root for local development.
# Loaded via `@golden-price/node-env` (CLI, www, worker).
# Public values are synced to GitHub Actions as repository variables (not secrets).

# Worker data API
PUBLIC_DATA_BASE_URL=https://golden-price.is-yuler.workers.dev

# Astro site URL and base path
SITE=https://gold.yuler.dev
BASE_PATH=/

# Optional: override local daily-grid root (default: <repo>/data)
# GOLDEN_PRICE_DATA_ROOT=
