{
  "name": "golden-price",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "cli:dev": "pnpm --filter @golden-price/cli dev",
    "cli:build": "pnpm --filter @golden-price/cli build",
    "cli:collect": "pnpm --filter @golden-price/cli collect",
    "cli:fetch": "pnpm --filter @golden-price/cli fetch",
    "www:dev": "pnpm --filter @golden-price/www dev",
    "www:build": "pnpm --filter @golden-price/www build"
  }
}
