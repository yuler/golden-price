{
  "name": "golden-price",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "collect": "pnpm --filter @golden-price/collector collect",
    "fetch": "pnpm --filter @golden-price/collector fetch",
    "dev:www": "pnpm --filter @golden-price/www dev",
    "build:www": "pnpm --filter @golden-price/www build"
  }
}
