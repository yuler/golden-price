{
  "name": "@golden-price/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'if [ -f ../../.env ]; then exec wrangler dev --env-file ../../.env; else exec wrangler dev; fi'",
    "deploy": "sh -c 'if [ -f ../../.env ]; then exec wrangler deploy --env-file ../../.env; else exec wrangler deploy; fi'",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "migrate:r2": "tsx scripts/migrate-local-data.ts"
  },
  "dependencies": {
    "@golden-price/core": "workspace:*",
    "@golden-price/node-env": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wrangler": "^4.115.0"
  }
}
