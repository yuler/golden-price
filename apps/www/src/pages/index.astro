---
import PriceDashboard from "../components/PriceDashboard";
import Layout from "../layouts/Layout.astro";
import { resolveDataBase } from "../lib/prices";

const base = import.meta.env.BASE_URL;
const dataBase = resolveDataBase(base, import.meta.env.PUBLIC_DATA_BASE_URL);
---

<Layout title="今日金价">
  <PriceDashboard client:load dataBase={dataBase} />
</Layout>
