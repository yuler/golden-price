---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Golden Price">
  <main class="page">
    <header class="hero">
      <p class="eyebrow">CNY / gram</p>
      <h1>Golden Price</h1>
      <p class="subtitle">Intraday gold prices collected every 10 minutes.</p>
    </header>

    <section class="panel">
      <div class="controls">
        <label class="field">
          <span>Channel</span>
          <select id="channel-select" disabled>
            <option value="">Loading…</option>
          </select>
        </label>
        <label class="field">
          <span>Date</span>
          <select id="date-select" disabled>
            <option value="">Loading…</option>
          </select>
        </label>
      </div>

      <div class="latest">
        <p class="latest-label">Latest price</p>
        <p class="latest-value" id="latest-value">—</p>
        <p class="latest-meta" id="latest-meta">Waiting for data…</p>
      </div>

      <p class="status" id="status" aria-live="polite"></p>
      <div id="chart" class="chart" role="img" aria-label="Intraday price chart"></div>
    </section>
  </main>
</Layout>

<script>
  import { initDashboard } from "../scripts/dashboard.ts";

  void initDashboard();
</script>

<style>
  .page {
    width: min(960px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.5rem 0 3rem;
  }

  .hero {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 650;
  }

  .subtitle {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  select {
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }

  .latest {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .latest-label {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .latest-value {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 650;
    color: var(--accent);
  }

  .latest-meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .status {
    min-height: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .chart {
    width: 100%;
    height: 420px;
  }
</style>
